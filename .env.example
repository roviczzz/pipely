# Environment variables for the CRM Dashboard Template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets.

# Prisma ORM
# SQLite database file (relative to the project root).
DATABASE_URL="file:./dev.db"

# NextAuth.js (Auth.js v5)
# Used to sign/verify session JWTs. Generate one with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-random-secret-key"

# Set to "true" when running locally over plain HTTP (trusts the request host).
AUTH_TRUST_HOST="true"

# Demo seed account (created by `npx prisma db seed`)
# Email: demo@example.com
# Password: password123